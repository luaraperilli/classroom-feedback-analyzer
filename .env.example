# Copie para ".env" e preencha. Em desenvolvimento local há fallbacks seguros;
# em produção a ausência de qualquer uma destas falha o boot de propósito.

# "development" ou "production" (padrão quando não definida)
FLASK_CONFIG=production

# Gere valores fortes e DISTINTOS:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Origem(ns) do frontend autorizadas no CORS, separadas por vírgula, sem barra final
CORS_ORIGINS=https://seu-frontend.vercel.app

# Postgres do Supabase — use a string do "Session pooler".
# Sem isto, o app cai no SQLite, que não sobrevive a redeploys.
DATABASE_URL=

# Rede (opcional). O Cloud Run injeta PORT automaticamente.
# HOST=0.0.0.0
# PORT=8080

# --- Aviso por e-mail (opcional) -------------------------------------------
# Só a rotina "flask calcular-explicacoes" usa isto, e ela roda na sua máquina.
# NÃO ponha estas variáveis no cloudrun.env.yaml: o serviço público não precisa
# poder enviar e-mail em nome de ninguém.
#
# Com Gmail, é preciso uma "senha de app" de 16 letras, não a senha da conta.
# Ela exige verificação em duas etapas ligada, e é criada em
# myaccount.google.com/apppasswords
#
# Sem estas variáveis, as explicações são calculadas normalmente e ninguém é
# avisado. O sistema informa isso ao rodar, em vez de falhar.
# SMTP_SERVIDOR=smtp.gmail.com
# SMTP_PORTA=587
# SMTP_USUARIO=seu.email@gmail.com
# SMTP_SENHA=
# SMTP_REMETENTE=Voz Discente <seu.email@gmail.com>
