# Copie para ".env" no desenvolvimento local, ou defina na Vercel em
# Settings -> Environment Variables.
#
# É lida em tempo de BUILD, não de execução: se não estiver definida no build,
# o bundle publicado aponta para localhost e o app parece morto sem erro claro.
# Depois de alterá-la na Vercel, é preciso refazer o deploy.

REACT_APP_API_BASE_URL=http://localhost:5001
